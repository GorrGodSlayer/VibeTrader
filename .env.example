# ---- Groq (the brain) ----
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for current model ids
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Server ----
HOST=127.0.0.1
PORT=8000
# Optional: HTTP basic auth for the dashboard (any username). Set this if you ever bind beyond localhost.
DASHBOARD_PASSWORD=
DB_PATH=vibetrader.db

# ---- Live trading (leave blank to stay paper-only) ----
# USE A BURNER WALLET. Base58 secret key (Phantom export format).
WALLET_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# true = build + simulate swaps via RPC, never send them
LIVE_DRY_RUN=true

# ---- Jupiter ----
JUPITER_API_BASE=https://lite-api.jup.ag
JUPITER_API_KEY=
