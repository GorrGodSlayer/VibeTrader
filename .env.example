# ---- Groq (the brain) ----
GROQ_API_KEY=
# Check https://console.groq.com/docs/models for current model ids
GROQ_MODEL=openai/gpt-oss-120b
# Each job runs on its own model: every Groq model has a separate daily quota (free tier: 30 req/min,
# 1,000 req/day, 8,000 tokens/min, 200,000 tokens/day per model), so splitting jobs multiplies the budget.
GROQ_SCREEN_MODEL=qwen/qwen3.8-27b
GROQ_MANAGE_MODEL=openai/gpt-oss-20b
GROQ_REFLECT_MODEL=qwen/qwen3.8-27b
# Per-model limits the pacer enforces; raise them if you move to a paid Groq tier.
GROQ_RPM=30
GROQ_TPM=8000
GROQ_TPD=200000

# ---- Server ----
HOST=127.0.0.1
PORT=8000
# Optional: HTTP basic auth for the dashboard (any username). Set this if you ever bind beyond localhost.
DASHBOARD_PASSWORD=
DB_PATH=vibetrader.db

# ---- Live trading (leave blank to stay paper-only) ----
# USE A BURNER WALLET. Base58 secret key (Phantom export format).
WALLET_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# true = build + simulate swaps via RPC, never send them
LIVE_DRY_RUN=true

# ---- Jupiter ----
JUPITER_API_BASE=https://lite-api.jup.ag
JUPITER_API_KEY=
